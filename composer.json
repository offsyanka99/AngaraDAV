{
    "name": "offsyanka99/angaradav",
    "type": "project",
    "description": "AngaraDAV is a self-hosted calendar, contacts, tasks, notes, and WebDAV file server derived from Baikal and powered by SabreDAV",
    "keywords": [
        "Project",
        "Server",
        "Calendar",
        "Contact",
        "WebDAV",
        "CalDAV",
        "CardDAV",
        "iCalendar",
        "lightweight"
    ],
    "homepage": "https://github.com/offsyanka99/AngaraDAV",
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.2",
        "sabre/dav": "~4.7.0",
        "twig/twig": "~3.27.1",
        "symfony/yaml": "~7.4.8",
        "symfony/string": "^7.2",
        "minishlink/web-push": "^9.0",
        "guzzlehttp/guzzle": "^7.9",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-zlib": "*"
    },
    "suggest": {
        "ext-gmp": "Faster VAPID/Web Push (RFC 8291/8292) elliptic-curve math for WebDAV-Push"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.89.2",
        "phpstan/phpstan": "2.1.53",
        "phpstan/phpstan-deprecation-rules": "2.0.4",
        "sebastian/diff": "^6.0"
    },
    "replace": {
        "jeromeschneider/baikal": "self.version",
        "sabre/baikal": "self.version"
    },
    "autoload": {
        "psr-0": {
            "BaikalAdmin": "Core/Frameworks/",
            "Baikal": "Core/Frameworks/",
            "Flake": "Core/Frameworks/",
            "Formal": "Core/Frameworks/"
        }
    },
    "support": {
        "source": "https://github.com/offsyanka99/AngaraDAV",
        "docs": "https://github.com/offsyanka99/AngaraDAV/tree/main/docs"
    },
    "scripts": {
        "cs-fixer": [
            "php-cs-fixer fix"
        ],
        "phpstan": [
            "phpstan analyse Core html"
        ],
        "test": [
            "composer cs-fixer",
            "composer phpstan"
        ],
        "apply-vendor-patches": [
            "sh scripts/apply-vendor-patches.sh"
        ],
        "post-install-cmd": [
            "@apply-vendor-patches"
        ],
        "post-update-cmd": [
            "@apply-vendor-patches"
        ]
    }
}
